# Optional. Leave empty to call /api/v1 on the app's own origin: `npm run dev` proxies /api to
# Django on 127.0.0.1:8000. Set a full URL (e.g. https://api.example.com/api/v1) to call another
# origin, which must then be in the backend's CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=

# Receipt issuer, printed on every payment receipt. Copy to .env.local (gitignored) and fill
# in; never commit real values: this repo is public. For a line break in the address, wrap
# it in double quotes and use \n: "Line one,\nLine two".
VITE_RECEIPT_ISSUER_NAME=Saleem Towers
VITE_RECEIPT_ISSUER_MANAGER=
VITE_RECEIPT_ISSUER_ADDRESS=
# E.164, e.g. +919876543210
VITE_RECEIPT_ISSUER_PHONE=
VITE_RECEIPT_ISSUER_EMAIL=

# Firebase web app (Firebase console > Project settings > General > Your apps > Web app).
# Public by design (they identify the project; security comes from Firebase Auth and the
# backend), but kept out of the repo. Use the same project as backend/.env FIREBASE_PROJECT_ID.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
