VITE_API_BASE_URL=

# Receipt issuer, printed on every payment receipt. Copy to .env.local (gitignored) and fill
# in; never commit real values: this repo is public. For a line break in the address, wrap
# it in double quotes and use \n: "Line one,\nLine two".
VITE_RECEIPT_ISSUER_NAME=Saleem Towers
VITE_RECEIPT_ISSUER_MANAGER=
VITE_RECEIPT_ISSUER_ADDRESS=
# E.164, e.g. +919876543210
VITE_RECEIPT_ISSUER_PHONE=
VITE_RECEIPT_ISSUER_EMAIL=
