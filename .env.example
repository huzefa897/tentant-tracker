# Optional. Leave empty to call /api/v1 on the app's own origin: `npm run dev` proxies /api to
# Django on 127.0.0.1:8000. Set a full URL (e.g. https://api.example.com/api/v1) to call another
# origin, which must then be in the backend's CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=

# Firebase web app (Firebase console > Project settings > General > Your apps > Web app).
# Public by design (they identify the project; security comes from Firebase Auth and the
# backend), but kept out of the repo. Use the same project as backend/.env FIREBASE_PROJECT_ID.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
