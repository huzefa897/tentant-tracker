{
  "name": "rent-tracker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:layout": "vitest run --config vitest.layout.config.ts",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "format:check": "prettier --check --experimental-cli src/",
    "lint:check": "oxlint . && eslint . --cache",
    "check:conflicts": "scripts/check-merge-conflicts.sh"
  },
  "dependencies": {
    "@expo-google-fonts/poppins": "^0.4.1",
    "@phosphor-icons/vue": "^2.2.1",
    "@tailwindcss/vite": "^4.3.5",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.21.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^13.4.0",
    "jspdf": "^4.2.1",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.46",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@fontsource/poppins": "5.3.0",
    "@tsconfig/node24": "^24.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/browser-playwright": "5.1.1",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.94.0",
    "eslint-plugin-vue": "~10.12.1",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.1",
    "npm-run-all2": "^9.1.0",
    "nx": "^24.0.6",
    "oxlint": "~1.94.0",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "shadcn-vue": "^2.9.0",
    "typescript": "~6.0.0",
    "vite": "^8.3.8",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.4",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "stylus": "^0.64.0"
  }
}
