# Copy to backend/.env and fill in. Never commit .env.
# Generate a key: pipenv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-generated-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Matches the db service in ../compose.yaml (local development only).
# Host port 5434, so it does not clash with other PostgreSQL instances on 5432/5433.
POSTGRES_DB=rent_tracker
POSTGRES_USER=rent_tracker
POSTGRES_PASSWORD=local_dev_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434
# "require" for a database reached over the internet (e.g. Supabase); unset for this one.
# POSTGRES_SSLMODE=require

# Production security (docs/security.md). Leave unset for local http development.
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_BEHIND_HTTPS_PROXY=True          # trust X-Forwarded-Proto from the TLS proxy
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_SECURE_COOKIES=True              # default: on unless DJANGO_DEBUG
# DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.com
# DJANGO_ADMIN_PATH=some-private-path/    # default admin/
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_LOG_LEVEL=INFO

# Rate limits (DRF rate strings). Behind a proxy, set how many there are so each client's own
# address is used; otherwise every client shares the proxy's address.
# DJANGO_THROTTLE_ADDRESS=300/minute      # every API request, per address
# DJANGO_THROTTLE_USER=300/minute         # per signed-in person
# DJANGO_THROTTLE_WRITES=30/minute        # writes, per signed-in person
# DJANGO_THROTTLE_HEALTH=10/minute        # /health/ and /ready/, per address, in memory
# DJANGO_NUM_PROXIES=1
# DJANGO_SHARED_CACHE=true               # share throttle counts across processes, in PostgreSQL
#                                         # (run `pipenv run python manage.py createcachetable` once)

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Firebase project used by the Vue app (Project settings > General > Project ID).
FIREBASE_PROJECT_ID=your-firebase-project-id
# Absolute path to the service-account JSON key, kept OUTSIDE the repository.
# Firebase console > Project settings > Service accounts > Generate new private key.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/the/repo/firebase-service-account.json
# Or, instead of the file (needed for `docker compose --profile app up`): the key's fields, one
# per variable, copied from the JSON. When FIREBASE_PRIVATE_KEY is set these are used and
# GOOGLE_APPLICATION_CREDENTIALS is ignored. Keep the private key on one line, in double
# quotes, with its line breaks as \n, exactly as it appears in the JSON.
# FIREBASE_PRIVATE_KEY_ID=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
# FIREBASE_CLIENT_ID=
# FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token   # the default


