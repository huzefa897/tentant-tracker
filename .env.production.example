# Production settings for compose.prod.yaml. Copy to .env.production on the server (it's
# gitignored), fill in every value, and keep it readable by the deploying user only
# (chmod 600). docs/deployment.md explains each part.

# --- The site -------------------------------------------------------------------------------
# The domain people open, pointing (DNS A/AAAA record) at this server. Caddy gets its HTTPS
# certificate automatically.
SITE_ADDRESS=rent.example.com
# HTTP_PORT=80
# HTTPS_PORT=443
# A local trial over plain http (docs/deployment.md), never on a real server:
#   SITE_ADDRESS=:80  HTTP_PORT=8080  HTTPS_PORT=8443  DJANGO_ALLOWED_HOSTS=localhost
#   DJANGO_SECURE_SSL_REDIRECT=false  DJANGO_SECURE_COOKIES=false  DJANGO_SECURE_HSTS_SECONDS=0

# --- Django ---------------------------------------------------------------------------------
# A new secret just for production, never the development one. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# The domain above (without https://).
DJANGO_ALLOWED_HOSTS=rent.example.com
# The site's origin, for admin's login form.
DJANGO_CSRF_TRUSTED_ORIGINS=https://rent.example.com
# Admin's path: something not obvious, ending in a slash.
DJANGO_ADMIN_PATH=replace-with-a-private-path/
# Empty: the app is served from the same origin as the API. Only for a separate frontend
# domain: its exact origin (and set VITE_API_BASE_URL below).
CORS_ALLOWED_ORIGINS=
# Set true only once every subdomain of the domain is HTTPS-only for good.
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# Gunicorn worker processes (2–4 suits a small server).
# WEB_CONCURRENCY=2

# --- PostgreSQL (production-only credentials) -----------------------------------------------
POSTGRES_DB=rent_tracker
POSTGRES_USER=rent_tracker
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# --- Firebase -------------------------------------------------------------------------------
# The production Firebase project: the backend and the web app must name the same one.
FIREBASE_PROJECT_ID=
# The service-account key, outside the repository (see docs/deployment.md for permissions).
FIREBASE_SERVICE_ACCOUNT_FILE=/etc/rent-tracker/firebase-service-account.json

# The web app's Firebase config (public, baked into the build).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Empty: call /api/v1 on the site itself. Only for a separate API domain, its full URL, e.g.
# https://api.example.com/api/v1.
VITE_API_BASE_URL=

# --- Backups (scripts/backup-db.sh) ---------------------------------------------------------
# Where dumps are written on this server, and how many days to keep them.
BACKUP_DIR=/var/backups/rent-tracker
BACKUP_RETENTION_DAYS=30
# A command that copies one dump off this server; {} is replaced by the dump's path. E.g.
#   rclone copy {} offsite:rent-tracker-backups
BACKUP_COPY_COMMAND=
# A monitoring URL pinged after each backup: the URL on success, the URL + /fail on failure
# (e.g. a healthchecks.io check, which alerts you when a ping is missing or fails).
BACKUP_HEALTHCHECK_URL=
